conky.config = {
    -- General
    update_interval = 1,
    total_run_times = 0,
    -- systemd owns the process; do not fork away from the user service.
    background = false,
    double_buffer = true,
    no_buffers = true,
    cpu_avg_samples = 2,
    net_avg_samples = 2,

    -- Window
    own_window = true,
    own_window_class = 'Conky',
    -- Keep Conky on Cinnamon's desktop layer instead of treating it as a
    -- normal application tied to the current workspace/window.
    own_window_type = 'desktop',
    own_window_transparent = true,
    own_window_argb_visual = true,
    own_window_argb_value = 0,

    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',

    -- Position
    alignment = 'top_right',
    gap_x = 35,
    gap_y = 45,
    minimum_width = 320,
    maximum_width = 320,

    -- Text
    use_xft = true,
    font = 'DejaVu Sans:size=10',
    xftalpha = 1,
    default_color = 'E6E6E6',
    color1 = '9AA0A6', -- secondary text and dividers
    color2 = 'EF5350', -- CPU and download
    color3 = '81C784', -- battery
    color4 = 'BA68C8', -- memory
    color5 = 'FFB74D', -- disk
    color6 = 'F06292', -- upload
    color7 = '64B5F6', -- section headings

    draw_shades = false,
    draw_outline = false,
    draw_borders = false,
    draw_graph_borders = false,

    uppercase = false,
    use_spacer = 'none',
    short_units = true,
};

conky.text = [[
${color7}${font DejaVu Sans:bold:size=11}SYSTEM${font}
${color1}${hr 2}${color}

Battery ${alignr}${color3}${battery_percent}%${color}
${color3}${battery_bar 6}${color}

CPU ${alignr}${color2}${cpu}%${color}
${cpugraph 35,320 263238 EF5350}

RAM ${alignr}${color4}${mem} / ${memmax}${color}
${color4}${membar 6}${color}

Disk ${alignr}${color5}${fs_used /} / ${fs_size /}${color}
${color5}${fs_bar 6 /}${color}

${color7}${font DejaVu Sans:bold:size=11}NETWORK${font}
${color1}${hr 2}${color}

Download ${alignr}${color2}${downspeed wlp0s20f3}${color}
${downspeedgraph wlp0s20f3 28,320 263238 EF5350}

Upload ${alignr}${color6}${upspeed wlp0s20f3}${color}
${upspeedgraph wlp0s20f3 28,320 263238 F06292}

${color7}${font DejaVu Sans:bold:size=11}TOP PROCESSES${font}
${color1}${hr 2}${color}

${color1}COMMAND${alignr}CPU    RAM${color}
${top name 1}${alignr}${color2}${top cpu 1}%  ${color4}${top mem 1}%${color}
${top name 2}${alignr}${color2}${top cpu 2}%  ${color4}${top mem 2}%${color}
${top name 3}${alignr}${color2}${top cpu 3}%  ${color4}${top mem 3}%${color}
${top name 4}${alignr}${color2}${top cpu 4}%  ${color4}${top mem 4}%${color}
${top name 5}${alignr}${color2}${top cpu 5}%  ${color4}${top mem 5}%${color}
]];
