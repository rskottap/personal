conky.config = {
    -- General
    update_interval = 1,
    total_run_times = 0,
    background = true,
    double_buffer = true,
    no_buffers = true,
    cpu_avg_samples = 2,
    net_avg_samples = 2,

    -- Window
    own_window = true,
    own_window_class = 'Conky',
    own_window_type = 'normal',
    own_window_transparent = true,
    own_window_argb_visual = true,
    own_window_argb_value = 0,

    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',

    -- Position
    alignment = 'top_right',
    gap_x = 35,
    gap_y = 45,
    minimum_width = 320,
    maximum_width = 320,

    -- Text
    use_xft = true,
    font = 'DejaVu Sans:size=10',
    xftalpha = 1,
    default_color = 'FFFFFF',
    color1 = 'AAAAAA',
    color2 = 'FFFFFF',

    draw_shades = false,
    draw_outline = false,
    draw_borders = false,
    draw_graph_borders = false,

    uppercase = false,
    use_spacer = 'none',
    short_units = true,
};

conky.text = [[
${font DejaVu Sans:light:size=36}${alignr}${time %H:%M}${font}
${color1}${alignr}${time %A, %B %d}${color}

${font DejaVu Sans:bold:size=11}SYSTEM${font}
${color1}${hr 2}${color}

Battery ${alignr}${battery_percent}%
${battery_bar 6}

CPU ${alignr}${cpu}%
${cpugraph 35,320}

RAM ${alignr}${mem} / ${memmax}
${membar 6}

Disk ${alignr}${fs_used /} / ${fs_size /}
${fs_bar 6 /}

${font DejaVu Sans:bold:size=11}NETWORK${font}
${color1}${hr 2}${color}

Download ${alignr}${downspeed wlp0s20f3}
${downspeedgraph wlp0s20f3 28,320}

Upload ${alignr}${upspeed wlp0s20f3}
${upspeedgraph wlp0s20f3 28,320}

${font DejaVu Sans:bold:size=11}TOP PROCESSES${font}
${color1}${hr 2}${color}

${color1}COMMAND${alignr}CPU    RAM${color}
${top name 1}${alignr}${top cpu 1}%  ${top mem 1}%
${top name 2}${alignr}${top cpu 2}%  ${top mem 2}%
${top name 3}${alignr}${top cpu 3}%  ${top mem 3}%
${top name 4}${alignr}${top cpu 4}%  ${top mem 4}%
${top name 5}${alignr}${top cpu 5}%  ${top mem 5}%
]];
